# Configurações de Persistência ZimaMail
DEFAULT_DOMAIN=amplifamarketing.com.br
DELIVERY_MODE=external

# Cloudflare (Opcional - Para Automação DNS)
CF_TOKEN=
CF_ZONE=

# Relay SMTP Padrão (Opcional - Se definido, cria um relay automático)
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASS=

# Armazenamento (Interno)
DATA_DIR=/app/data

# Supabase (Configuração de Banco de Dados)
# Exemplo URL: https://xyz.supabase.co
SUPABASE_URL=
SUPABASE_SERVICE_ROLE_KEY=
SUPABASE_ANON_KEY=
# Replique as mesmas informações VITE para o Frontend
VITE_SUPABASE_URL=
VITE_SUPABASE_ANON_KEY=
